generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id                String   @id @default(cuid())
  reference         String   @unique
  name              String?
  category          String
  imagePath         String
  originalImagePath String?
  price             Float?
  weight            Float?
  carat             Int?
  goldRatePerGram   Float?
  stock             Int?
  description       String?
  isActive          Boolean  @default(false)
  homeFeaturedOrder Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  images            ProductImage[]
}

model CategoryLabourCharge {
  id            String   @id @default(cuid())
  category      String   @unique
  amount        Float
  updatedAt     DateTime @updatedAt
}

model ManualMetalRate {
  id           String   @id @default(cuid())
  purity       String   @unique
  ratePerGram  Float
  updatedAt    DateTime @updatedAt
}

model BillingSettings {
  id        String   @id
  gstNumber String?
  updatedAt DateTime @updatedAt
}

model Bill {
  id            String   @id @default(cuid())
  billNumber    String   @unique
  shareToken    String   @unique
  customerName  String
  customerPhone String
  gstNumber     String?
  itemsJson     String
  subtotal      Float
  cgst          Float
  sgst          Float
  total         Float
  createdAt     DateTime @default(now())
}

model ProductImage {
  id        String   @id @default(cuid())
  imagePath String
  publicId  String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Enquiry {
  id               String   @id @default(cuid())
  customerName     String
  customerEmail    String
  customerPhone    String?
  message          String
  productReference String?
  productImagePath String?
  createdAt        DateTime @default(now())
  isRead           Boolean  @default(false)

  @@index([createdAt])
}
